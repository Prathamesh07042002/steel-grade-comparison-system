# Copy to .env next to docker-compose.yml. Never commit the real file.
#
#   cp .env.example .env
#
# On the EC2 host you do not need to create this by hand — the deploy workflow
# (.github/workflows/deployment.yml) writes .env from the repo secrets on every
# push. docker-compose declares `env_file: .env` for the tc_compliance_web
# service and refuses to start if the file is absent, so an empty `touch .env`
# is the floor for local routing/asset testing.

# REQUIRED. Every LLM path in the app uses Mistral and there is no fallback
# provider:
#   comparator/src/ocr.py         -> mistral-ocr-latest  (certificate OCR)
#   comparator/src/comparator.py  -> mistral-large-latest (property matching)
# Both read it via os.getenv at import time. Without it, uploads fail with
# "MISTRAL_API_KEY not found in .env file" — the container still starts and
# /health still passes, so a missing key surfaces only on first use.
MISTRAL_API_KEY=
